# Copy this file to .env and replace the placeholder with your own Gemini API key.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_VALUE
ADMIN_USERNAME=SET_A_PRIVATE_ADMIN_USERNAME
ADMIN_PASSWORD_HASH=PASTE_A_WERKZEUG_PASSWORD_HASH_HERE
SESSION_COOKIE_SECURE=false
